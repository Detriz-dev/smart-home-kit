{
  "source": ["src/**/*.json"],
  "log": {
    "verbosity": "verbose"
  },
  "platforms": {
    "css": {
      "transformGroup": "css",
      "prefix": "shk",
      "buildPath": "dist/",
      "files": [
        {
          "destination": "tokens.css",
          "format": "css/variables",
          "options": {
            "outputReferences": true
          }
        }
      ]
    }
  }
}
