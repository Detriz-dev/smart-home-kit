{
  "name": "@detriz-sh-kit/ui",
  "version": "0.1.1",
  "description": "React components for DeTriz Smart Home Kit",
  "keywords": [
    "react",
    "components",
    "design system",
    "smart home",
    "iot",
    "detriz"
  ],
  "homepage": "https://smart-home-kit.detriz.com",
  "bugs": "https://github.com/Detriz-dev/smart-home-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Detriz-dev/smart-home-kit.git",
    "directory": "kit/packages/ui"
  },
  "license": "MIT",
  "author": "Dawid Kowalczyk",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && cp src/fonts.css dist/fonts.css && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "icons": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate-icons.mjs",
    "check:package": "publint && attw --pack . --profile esm-only --entrypoints . --ignore-rules internal-resolution-error"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.48.0",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@detriz-sh-kit/tokens": "workspace:*",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
