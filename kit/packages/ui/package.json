    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@detriz-sh-kit/tokens": "workspace:*"
  }
