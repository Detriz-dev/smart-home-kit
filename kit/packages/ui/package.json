{
  "name": "@detriz-sh-kit/ui",
  "version": "0.0.0",
  "description": "React components for DeTriz Smart Home Kit",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
