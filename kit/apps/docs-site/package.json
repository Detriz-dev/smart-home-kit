{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for DeTriz Smart Home Kit",
  "scripts": {
    "dev": "docusaurus start",
    "build": "docusaurus build --out-dir dist",
    "serve": "docusaurus serve --dir dist",
